# ================================================================
# Variáveis de Ambiente — JPS Steel Backoffice
# ================================================================
# Copie este arquivo para `.env` (no raiz do projeto) e preencha
# as credenciais. Obtenha o bloco do Firebase em:
#   Console Firebase > Configurações do projeto > Configuração > Aplicativos da Web
# ================================================================

# ----- Firebase -----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----- Cloudinary (upload de fotos, preset unsigned) -----
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=